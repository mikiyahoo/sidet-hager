datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Episode {
  id            String   @id @default(cuid())
  title         String
  category      String
  publishDate   DateTime
  videoUrl      String
  shortDetail   String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeamMember {
  id              String   @id @default(cuid())
  fullName        String
  roleTitle       String
  imageAssetPath  String
  displayOrder    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}